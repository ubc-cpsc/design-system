{
    "private": true,
    "scripts": {
        "build:sass": "sass sass:public/css",
        "autoprefixer": "postcss --no-map -u autoprefixer --autoprefixer.browsers -r public/css/*.css",
        "build:css": "pnpm run build:sass && pnpm run autoprefixer",
        "watch:css": "onchange 'sass/**/*.scss' -- pnpm run build:css"
    },
    "dependencies": {
        "bootstrap": "^5.0.0",
        "jszip": "^3.10.1",
        "normalize.css": "^8.0.0",
        "prism-themes": "^1.0.0",
        "prismjs": "^1.0.0"
    },
    "devDependencies": {
        "autoprefixer": "^10.5.4",
        "onchange": "^7.0.0",
        "postcss-cli": "^11.0.0",
        "sass": "^1.102.0"
    },
    "copyFiles": [
        {
            "from": "node_modules/prismjs/dist/*",
            "to": "js/vendor/fancybox"
        }
    ],
    "copyFilesSettings": {
        "whenFileExists": "overwrite"
    },
    "browserslist": [
        "> 1%"
    ],
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
