{
    "private": true,
    "scripts": {
        "build:sass": "sass sass:public/css",
        "autoprefixer": "postcss --no-map -u autoprefixer --autoprefixer.browsers -r public/css/*.css",
        "build:css": "pnpm run build:sass && pnpm run autoprefixer",
        "watch:css": "onchange 'sass/**/*.scss' -- pnpm run build:css"
    },
    "dependencies": {
        "bootstrap": "^5.0.0",
        "jszip": "^3.10.1",
        "normalize.css": "^8.0.0",
        "prism-themes": "^1.0.0",
        "prismjs": "^1.0.0"
    },
    "devDependencies": {
        "autoprefixer": "^10.5.4",
        "onchange": "^7.0.0",
        "postcss-cli": "^11.0.0",
        "sass": "^1.0.0"
    },
    "copyFiles": [
        {
            "from": "node_modules/prismjs/dist/*",
            "to": "js/vendor/fancybox"
        }
    ],
    "copyFilesSettings": {
        "whenFileExists": "overwrite"
    },
    "browserslist": [
        "> 1%"
    ],
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
